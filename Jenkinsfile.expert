pipeline {
    agent none
    
    environment {
        // Variables generales
        APP_NAME = 'jenkins-cloud-native-app'
        ENVIRONMENT = params.ENVIRONMENT ?: 'dev'
        AWS_REGION = 'us-east-1'
        TF_STATE_BUCKET = 'jenkins-tf-state'
        DOCKER_REGISTRY = '123456789012.dkr.ecr.us-east-1.amazonaws.com'
        PROMETHEUS_URL = 'http://prometheus.monitoring.svc.cluster.local:9090'
        VAULT_ADDR = 'https://vault.example.com'
    }
    
    parameters {
        choice(
            name: 'ENVIRONMENT',
            choices: ['dev', 'staging', 'production'],
            description: 'Ambiente de despliegue'
        )
        string(
            name: 'APP_VERSION',
            defaultValue: 'latest',
            description: 'Versión de la aplicación'
        )
        booleanParam(
            name: 'DEPLOY_INFRASTRUCTURE',
            defaultValue: false,
            description: 'Desplegar infraestructura con Terraform'
        )
        booleanParam(
            name: 'RUN_CHAOS_EXPERIMENTS',
            defaultValue: false,
            description: 'Ejecutar experimentos de Chaos Engineering'
        )
    }
    
    stages {
        stage('Validación de Código y Seguridad') {
            parallel {
                stage('Análisis de Código') {
                    agent {
                        docker {
                            image 'sonarsource/sonar-scanner-cli:latest'
                        }
                    }
                    steps {
                        echo '🔍 Analizando código con SonarQube...'
                        withSonarQubeEnv('SonarQube') {
                            sh '''
                                sonar-scanner \
                                    -Dsonar.projectKey=${APP_NAME} \
                                    -Dsonar.sources=. \
                                    -Dsonar.host.url=${SONAR_HOST_URL} \
                                    -Dsonar.login=${SONAR_TOKEN}
                            '''
                        }
                    }
                }
                
                stage('Escaneo de Vulnerabilidades') {
                    agent {
                        docker {
                            image 'aquasec/trivy:latest'
                        }
                    }
                    steps {
                        echo '🔐 Escaneando dependencias...'
                        sh '''
                            trivy fs --severity HIGH,CRITICAL --exit-code 0 .
                            trivy image ${DOCKER_REGISTRY}/${APP_NAME}:${APP_VERSION} --severity HIGH,CRITICAL
                        '''
                    }
                }
                
                stage('Secret Detection') {
                    agent { label 'docker' }
                    steps {
                        echo '🔑 Detectando secretos en código...'
                        sh '''
                            git secrets --scan
                            trufflehog --regex --entropy=True .
                        '''
                    }
                }
            }
        }
        
        stage('Infraestructura como Código') {
            when {
                expression { params.DEPLOY_INFRASTRUCTURE }
            }
            agent { label 'docker' }
            environment {
                TF_VAR_environment = ENVIRONMENT
                TF_VAR_aws_region = AWS_REGION
            }
            steps {
                echo '🏗️ Desplegando infraestructura con Terraform...'
                script {
                    sh """
                        cd infrastructure/terraform/environments/${ENVIRONMENT}
                        
                        # Inicializar Terraform
                        terraform init \
                            -backend-config="bucket=${TF_STATE_BUCKET}" \
                            -backend-config="key=${APP_NAME}/${ENVIRONMENT}/terraform.tfstate"
                        
                        # Planificar cambios
                        terraform plan -out=tfplan
                        
                        # Aplicar cambios con aprobación manual para producción
                        if [ "${ENVIRONMENT}" == "production" ]; then
                            echo "📝 Revisión manual requerida para producción"
                            input message: '¿Aprobar despliegue en producción?', ok: 'Sí'
                        fi
                        
                        terraform apply tfplan
                        
                        # Guardar outputs
                        terraform output -json > outputs.json
                    """
                }
            }
        }
        
        stage('Build y Push de Imágenes') {
            agent { label 'docker' }
            environment {
                ECR_REGISTRY = "${DOCKER_REGISTRY}"
            }
            steps {
                echo '🏗️ Construyendo y subiendo imágenes...'
                script {
                    sh """
                        # Login a ECR
                        aws ecr get-login-password --region ${AWS_REGION} | \
                            docker login --username AWS --password-stdin ${ECR_REGISTRY}
                        
                        # Construir multi-arch
                        docker buildx build \
                            --platform linux/amd64,linux/arm64 \
                            --tag ${ECR_REGISTRY}/${APP_NAME}:${APP_VERSION} \
                            --tag ${ECR_REGISTRY}/${APP_NAME}:${BUILD_TIMESTAMP} \
                            --push .
                    """
                }
            }
        }
        
        stage('Pruebas de Rendimiento y Escalabilidad') {
            agent { label 'docker' }
            steps {
                echo '⚡ Ejecutando pruebas de rendimiento...'
                script {
                    // Escenarios de prueba
                    def scenarios = [
                        'smoke': 10,
                        'load': 100,
                        'stress': 500,
                        'spike': 1000
                    ]
                    
                    scenarios.each { name, users ->
                        sh """
                            echo "=== Ejecutando prueba: ${name} con ${users} usuarios ==="
                            k6 run \
                                -e SCENARIO=${name} \
                                -e USERS=${users} \
                                -e DURATION=60s \
                                tests/performance/scenario.js
                        """
                    }
                }
            }
            post {
                always {
                    // Publicar resultados de rendimiento
                    publishHTML([
                        reportDir: 'performance-reports/',
                        reportFiles: 'index.html',
                        reportName: 'Performance Tests'
                    ])
                }
            }
        }
        
        stage('Auto-Scaling basado en Métricas') {
            when {
                expression { ENVIRONMENT == 'production' && params.DEPLOY_INFRASTRUCTURE }
            }
            agent { label 'docker' }
            steps {
                echo '📈 Configurando auto-scaling...'
                script {
                    // Desplegar Horizontal Pod Autoscaler
                    sh """
                        kubectl apply -f - <<EOF
                        apiVersion: autoscaling/v2
                        kind: HorizontalPodAutoscaler
                        metadata:
                          name: ${APP_NAME}-hpa
                          namespace: ${ENVIRONMENT}
                        spec:
                          scaleTargetRef:
                            apiVersion: apps/v1
                            kind: Deployment
                            name: ${APP_NAME}
                          minReplicas: 2
                          maxReplicas: 10
                          metrics:
                          - type: Resource
                            resource:
                              name: cpu
                              target:
                                type: Utilization
                                averageUtilization: 70
                          - type: Resource
                            resource:
                              name: memory
                              target:
                                type: Utilization
                                averageUtilization: 80
                          - type: Pods
                            pods:
                              metric:
                                name: http_requests_per_second
                              target:
                                type: AverageValue
                                averageValue: 100
EOF
                    """
                    
                    // Configurar auto-scaling basado en SQS
                    sh """
                        kubectl apply -f - <<EOF
                        apiVersion: keda.sh/v1alpha1
                        kind: ScaledObject
                        metadata:
                          name: ${APP_NAME}-scaledobject
                          namespace: ${ENVIRONMENT}
                        spec:
                          scaleTargetRef:
                            name: ${APP_NAME}
                          minReplicaCount: 2
                          maxReplicaCount: 20
                          triggers:
                          - type: aws-sqs-queue
                            metadata:
                              queueName: ${APP_NAME}-queue
                              queueLength: '50'
                              awsRegion: ${AWS_REGION}
EOF
                    """
                }
            }
        }
        
        stage('Service Mesh con Istio') {
            when {
                expression { ENVIRONMENT == 'production' }
            }
            agent { label 'docker' }
            steps {
                echo '🌐 Configurando Istio Service Mesh...'
                script {
                    // Desplegar VirtualService y DestinationRule
                    sh """
                        kubectl apply -f - <<EOF
                        apiVersion: networking.istio.io/v1beta1
                        kind: VirtualService
                        metadata:
                          name: ${APP_NAME}-vs
                          namespace: ${ENVIRONMENT}
                        spec:
                          hosts:
                          - ${APP_NAME}
                          http:
                          - route:
                            - destination:
                                host: ${APP_NAME}
                                port:
                                  number: 8080
                              weight: 90
                            - destination:
                                host: ${APP_NAME}-canary
                                port:
                                  number: 8080
                              weight: 10
                            mirror:
                              host: ${APP_NAME}-mirror
                            retries:
                              attempts: 3
                              perTryTimeout: 2s
                            fault:
                              delay:
                                percentage:
                                  value: 0.1
                                fixedDelay: 5s
EOF
                    """
                    
                    // Configurar Circuit Breaking
                    sh """
                        kubectl apply -f - <<EOF
                        apiVersion: networking.istio.io/v1beta1
                        kind: DestinationRule
                        metadata:
                          name: ${APP_NAME}-dr
                          namespace: ${ENVIRONMENT}
                        spec:
                          host: ${APP_NAME}
                          trafficPolicy:
                            connectionPool:
                              tcp:
                                maxConnections: 100
                            loadBalancer:
                              simple: ROUND_ROBIN
                            outlierDetection:
                              consecutive5xxErrors: 5
                              interval: 30s
                              baseEjectionTime: 60s
EOF
                    """
                }
            }
        }
        
        stage('Chaos Engineering') {
            when {
                expression { params.RUN_CHAOS_EXPERIMENTS && ENVIRONMENT != 'production' }
            }
            agent { label 'docker' }
            steps {
                echo '🧪 Ejecutando experimentos de Chaos Engineering...'
                script {
                    // Instalar Litmus
                    sh """
                        kubectl create ns chaos-testing
                        kubectl apply -f https://litmuschaos.github.io/litmus/litmus-operator-latest.yaml
                        kubectl apply -f chaos/experiments/
                    """
                    
                    // Ejecutar experimentos
                    def experiments = [
                        'pod-failure': 'Pod Failure Experiment',
                        'network-latency': 'Network Latency Experiment',
                        'cpu-hog': 'CPU Stress Experiment'
                    ]
                    
                    experiments.each { name, description ->
                        sh """
                            echo "=== Ejecutando: ${description} ==="
                            kubectl apply -f chaos/experiments/${name}.yaml
                            
                            # Esperar a que termine
                            timeout 300 sh -c '
                                while [ \$(kubectl get chaosresult ${name}-result -o jsonpath="{.status.experimentStatus.verdict}") != "Pass" ]; do
                                    echo "Esperando experimento ${name}..."
                                    sleep 10
                                done
                            '
                            
                            # Verificar recuperación
                            kubectl get pods -n ${ENVIRONMENT} | grep -v Terminating
                        """
                    }
                }
            }
        }
        
        stage('Blue/Green Deployment') {
            when {
                expression { ENVIRONMENT == 'production' }
            }
            agent { label 'docker' }
            steps {
                echo '🔵🔴 Desplegando con estrategia Blue/Green...'
                script {
                    // Identificar color actual
                    def currentColor = sh(
                        script: """
                            kubectl get service ${APP_NAME} -n ${ENVIRONMENT} -o jsonpath='{.metadata.labels.color}'
                        """,
                        returnStdout: true
                    ).trim() ?: 'blue'
                    
                    def newColor = currentColor == 'blue' ? 'green' : 'blue'
                    
                    // Desplegar nuevo color
                    sh """
                        sed "s/COLOR_PLACEHOLDER/${newColor}/g" kubernetes/overlays/${ENVIRONMENT}/deployment.yaml | \
                            kubectl apply -f -
                        
                        # Esperar que el nuevo deployment esté listo
                        kubectl rollout status deployment/${APP_NAME}-${newColor} -n ${ENVIRONMENT}
                        
                        # Ejecutar pruebas de humo en nuevo deployment
                        kubectl run smoke-test --image=busybox --rm -it --restart=Never -- \
                            wget -qO- http://${APP_NAME}-${newColor}.${ENVIRONMENT}.svc.cluster.local:8080/health
                    """
                    
                    // Switch de tráfico
                    sh """
                        # Cambiar selector de servicio
                        kubectl patch service ${APP_NAME} -n ${ENVIRONMENT} -p \
                            '{"spec":{"selector":{"color":"${newColor}"}}}'
                        
                        # Actualizar label de color
                        kubectl label service ${APP_NAME} -n ${ENVIRONMENT} color=${newColor} --overwrite
                    """
                    
                    // Mantener old version por rollback
                    sh """
                        echo "Manteniendo versión anterior por 5 minutos para rollback..."
                        sleep 300
                        kubectl delete deployment ${APP_NAME}-${currentColor} -n ${ENVIRONMENT}
                    """
                }
            }
        }
        
        stage('Monitoreo y Alertas') {
            agent { label 'docker' }
            steps {
                echo '📊 Configurando monitoreo avanzado...'
                script {
                    // Configurar Prometheus rules
                    sh """
                        kubectl apply -f monitoring/alertmanager/rules.yml
                        
                        # Configurar Grafana dashboards
                        kubectl create configmap grafana-dashboards \
                            --from-file=monitoring/grafana/dashboards/ \
                            -n monitoring --dry-run=client -o yaml | kubectl apply -f -
                    """
                    
                    // Verificar métricas
                    def metrics = [
                        'app_requests_total',
                        'app_response_time_seconds',
                        'app_error_rate',
                        'container_cpu_usage',
                        'container_memory_usage'
                    ]
                    
                    metrics.each { metric ->
                        sh """
                            echo "Verificando métrica: ${metric}"
                            curl -s -G ${PROMETHEUS_URL}/api/v1/query \
                                --data-urlencode "query=${metric}" | jq .
                        """
                    }
                }
            }
        }
        
        stage('GitOps Sync con ArgoCD') {
            when {
                expression { ENVIRONMENT == 'production' }
            }
            agent { label 'docker' }
            steps {
                echo '🔄 Sincronizando con ArgoCD...'
                script {
                    sh """
                        argocd app sync ${APP_NAME}-${ENVIRONMENT} \
                            --grpc-web \
                            --server argocd.example.com
                        
                        # Esperar sincronización
                        argocd app wait ${APP_NAME}-${ENVIRONMENT} \
                            --health \
                            --timeout 300 \
                            --grpc-web \
                            --server argocd.example.com
                    """
                }
            }
        }
        
        stage('Recovery Automático') {
            when {
                expression { ENVIRONMENT == 'production' }
            }
            agent { label 'docker' }
            steps {
                echo '🔄 Configurando recovery automático...'
                script {
                    // Implementar self-healing
                    sh """
                        # Configurar pod disruption budget
                        kubectl apply -f - <<EOF
                        apiVersion: policy/v1
                        kind: PodDisruptionBudget
                        metadata:
                          name: ${APP_NAME}-pdb
                          namespace: ${ENVIRONMENT}
                        spec:
                          minAvailable: 2
                          selector:
                            matchLabels:
                              app: ${APP_NAME}
EOF
                        
                        # Configurar liveness y readiness probes
                        kubectl patch deployment ${APP_NAME} -n ${ENVIRONMENT} -p '
                        spec:
                          template:
                            spec:
                              containers:
                              - name: app
                                livenessProbe:
                                  httpGet:
                                    path: /health
                                    port: 8080
                                  initialDelaySeconds: 30
                                  periodSeconds: 10
                                readinessProbe:
                                  httpGet:
                                    path: /ready
                                    port: 8080
                                  initialDelaySeconds: 5
                                  periodSeconds: 5
                                startupProbe:
                                  httpGet:
                                    path: /health
                                    port: 8080
                                  failureThreshold: 30
                                  periodSeconds: 10
                        '
                    """
                }
            }
        }
    }
    
    post {
        success {
            echo '✅ Pipeline completado exitosamente'
            script {
                // Enviar notificación a Slack
                slackSend(
                    color: 'good',
                    message: """
                        ✅ Pipeline exitoso: ${env.JOB_NAME} #${env.BUILD_NUMBER}
                        Ambiente: ${ENVIRONMENT}
                        Versión: ${APP_VERSION}
                        URL: ${env.BUILD_URL}
                        Dashboard: https://grafana.example.com/d/${APP_NAME}
                    """
                )
            }
        }
        failure {
            echo '❌ Pipeline falló. Iniciando recovery...'
            script {
                if (ENVIRONMENT == 'production') {
                    // Ejecutar scripts de rollback automático
                    sh """
                        ./scripts/rollback.sh ${ENVIRONMENT}
                        kubectl rollout undo deployment/${APP_NAME} -n ${ENVIRONMENT}
                    """
                }
            }
            slackSend(
                color: 'danger',
                message: """
                    ❌ Pipeline fallido: ${env.JOB_NAME} #${env.BUILD_NUMBER}
                    Ambiente: ${ENVIRONMENT}
                    URL: ${env.BUILD_URL}
                    Rollback automático ejecutado.
                """
            )
        }
        always {
            echo '🧹 Limpiando recursos...'
            cleanWs()
        }
    }
}